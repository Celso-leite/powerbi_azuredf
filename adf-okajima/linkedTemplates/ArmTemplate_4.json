	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_okj360_oracle_adls')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy_OKJ360_Base_Desdobrada",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.01:30:00",
							"retry": 2,
							"retryIntervalInSeconds": 60,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "OracleSource",
								"oracleReaderQuery": "SELECT CAST(ID_CICLO AS NUMBER(18,0)) AS ID_CICLO, DATA_INICIO, CAST(VERSAO AS NUMBER(6,0)) AS VERSAO, CAST(CODIGO_CLIENTE AS NUMBER(9,0)) AS CODIGO_CLIENTE, TIPO_BASE_VENCEDORA, CAST(CODIGO_TELEVENDEDOR AS NUMBER(18,0)) AS CODIGO_TELEVENDEDOR, CAST(CODIGO_RCA_CAMPO AS NUMBER(18,0)) AS CODIGO_RCA_CAMPO, METODO_DISTRIBUICAO, CLIENTE_ORFAO, DATA_ULTIMA_VENDA_FISICA, CAST(DIAS_SEM_VENDA_FISICA AS NUMBER(6,0)) AS DIAS_SEM_VENDA_FISICA, CAST(QTD_MESES_COM_COMPRA AS NUMBER(3,0)) AS QTD_MESES_COM_COMPRA, VERSAO_REGRA, CAST(QTD_ALOCACOES_ATIVAS AS NUMBER(18,0)) AS QTD_ALOCACOES_ATIVAS FROM OKAJIMA.OKJ360_BASE_DESDOBRADA_PBI",
								"partitionOption": "None",
								"queryTimeout": "00:30:00"
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": false,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "ds_oracle_dynamic",
								"type": "DatasetReference",
								"parameters": {
									"SchemaName": "OKAJIMA",
									"TableName": "OKJ360_BASE_DESDOBRADA_PBI"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_adls_dynamic",
								"type": "DatasetReference",
								"parameters": {
									"Directory": "fatos/okj360_base_desdobrada_pbi",
									"FileName": "okj360_base_desdobrada_pbi.parquet"
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"folder": {
					"name": "fatos"
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_potencial_Rota_oracle_adls')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "ForEach_Potencial_Rotas",
						"type": "ForEach",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@pipeline().parameters.TableConfigurations",
								"type": "Expression"
							},
							"isSequential": false,
							"batchCount": 5,
							"activities": [
								{
									"name": "Copy_Oracle_to_ADLS",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.01:30:00",
										"retry": 2,
										"retryIntervalInSeconds": 60,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "OracleSource",
											"oracleReaderQuery": "WITH PARAMETROS AS (\r\n    SELECT\r\n        GREATEST(\r\n            TRUNC(SYSDATE, 'YYYY'),\r\n            ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -3)\r\n        ) AS DATA_INICIO,\r\n        TRUNC(SYSDATE, 'MM') AS DATA_FIM\r\n    FROM DUAL\r\n),\r\nCLIENTES_ELEGIVEIS AS (\r\n    SELECT\r\n        C.CODCLI,\r\n        C.CODATV1,\r\n        C.CODCIDADE\r\n    FROM OKAJIMA.PCCLIENT C\r\n    WHERE C.DTEXCLUSAO IS NULL\r\n),\r\nMOVIMENTOS_FORNECEDOR AS (\r\n    SELECT\r\n        F.CODIGOCLIENTE,\r\n        F.CODIGOFORNECEDOR,\r\n        SUM(NVL(F.VALORTOTAL, 0)) AS VALOR_LIQUIDO\r\n    FROM OKAJIMA.OKJ_FATOFATURAMENTO_PBI F\r\n    CROSS JOIN PARAMETROS P\r\n    WHERE F.DATAFATURAMENTO >= P.DATA_INICIO\r\n      AND F.DATAFATURAMENTO <  P.DATA_FIM\r\n      AND F.CODIGOFILIAL IN ('2', '3')\r\n      AND (F.CODIGORCAVENDA NOT IN (325, 4119, 4668, 7305)\r\n           OR F.CODIGORCAVENDA IS NULL)\r\n    GROUP BY F.CODIGOCLIENTE, F.CODIGOFORNECEDOR\r\n\r\n    UNION ALL\r\n\r\n    SELECT\r\n        D.CODIGOCLIENTE,\r\n        D.CODIGOFORNECEDOR,\r\n        -SUM(NVL(D.VALORTOTAL, 0)) AS VALOR_LIQUIDO\r\n    FROM OKAJIMA.OKJ_FATODEVOLUCAO_PBI D\r\n    CROSS JOIN PARAMETROS P\r\n    WHERE D.DATADEVOLUCAO >= P.DATA_INICIO\r\n      AND D.DATADEVOLUCAO <  P.DATA_FIM\r\n      AND D.CODIGOFILIAL IN ('2', '3')\r\n      AND (D.CODIGORCAVENDA NOT IN (325, 4119, 4668, 7305)\r\n           OR D.CODIGORCAVENDA IS NULL)\r\n    GROUP BY D.CODIGOCLIENTE, D.CODIGOFORNECEDOR\r\n),\r\nMOVIMENTOS_PASTA AS (\r\n    SELECT\r\n        M.CODIGOCLIENTE,\r\n        NVL(TRIM(F.PASTA_CAMPANHA), 'SEM PASTA') AS PASTA,\r\n        SUM(M.VALOR_LIQUIDO) AS FAT_LIQUIDO_PASTA_3M\r\n    FROM MOVIMENTOS_FORNECEDOR M\r\n    LEFT JOIN OKAJIMA.OKJ_DIMFORNECEDOR_PBI F\r\n        ON F.CODIGO_FORNECEDOR = M.CODIGOFORNECEDOR\r\n    GROUP BY\r\n        M.CODIGOCLIENTE,\r\n        NVL(TRIM(F.PASTA_CAMPANHA), 'SEM PASTA')\r\n),\r\nFAT_CLIENTE AS (\r\nSELECT\r\n    CAST(C.CODCLI AS NUMBER(16,0)) AS CODIGOCLIENTE,\r\n    CAST(NVL(SUM(M.FAT_LIQUIDO_PASTA_3M), 0) AS NUMBER(20,6))\r\n        AS FAT_LIQUIDO_TOTAL_3M,\r\n    CAST(SUM(CASE WHEN M.PASTA = 'BU CGI'\r\n                  THEN NVL(M.FAT_LIQUIDO_PASTA_3M, 0) ELSE 0 END)\r\n         AS NUMBER(20,6)) AS FAT_BU_CGI_3M,\r\n    CAST(SUM(CASE WHEN M.PASTA = 'BU PERFUMARIA'\r\n                  THEN NVL(M.FAT_LIQUIDO_PASTA_3M, 0) ELSE 0 END)\r\n         AS NUMBER(20,6)) AS FAT_BU_PERFUMARIA_3M,\r\n    CAST(SUM(CASE WHEN M.PASTA = 'BU DISTRIBUICAO'\r\n                  THEN NVL(M.FAT_LIQUIDO_PASTA_3M, 0) ELSE 0 END)\r\n         AS NUMBER(20,6)) AS FAT_BU_DISTRIBUICAO_3M,\r\n    CAST(SUM(CASE WHEN M.PASTA = 'DDF'\r\n                  THEN NVL(M.FAT_LIQUIDO_PASTA_3M, 0) ELSE 0 END)\r\n         AS NUMBER(20,6)) AS FAT_DDF_3M,\r\n    CAST(SUM(CASE WHEN M.PASTA = 'OUTLET'\r\n                  THEN NVL(M.FAT_LIQUIDO_PASTA_3M, 0) ELSE 0 END)\r\n         AS NUMBER(20,6)) AS FAT_OUTLET_3M,\r\n    CAST(SUM(CASE WHEN M.PASTA = 'PREDILECTA'\r\n                  THEN NVL(M.FAT_LIQUIDO_PASTA_3M, 0) ELSE 0 END)\r\n         AS NUMBER(20,6)) AS FAT_PREDILECTA_3M,\r\n    CAST(SUM(CASE WHEN M.PASTA = 'SALAO DE BELEZA'\r\n                  THEN NVL(M.FAT_LIQUIDO_PASTA_3M, 0) ELSE 0 END)\r\n         AS NUMBER(20,6)) AS FAT_SALAO_BELEZA_3M,\r\n    CAST(SUM(CASE WHEN M.PASTA = 'DESCONTINUADOS'\r\n                  THEN NVL(M.FAT_LIQUIDO_PASTA_3M, 0) ELSE 0 END)\r\n         AS NUMBER(20,6)) AS FAT_DESCONTINUADOS_3M,\r\n    CAST(SUM(CASE WHEN M.PASTA = 'SEM PASTA'\r\n                  THEN NVL(M.FAT_LIQUIDO_PASTA_3M, 0) ELSE 0 END)\r\n         AS NUMBER(20,6)) AS FAT_SEM_PASTA_3M,\r\n    CAST(SUM(CASE WHEN M.PASTA NOT IN ('BU CGI', 'BU PERFUMARIA', 'BU DISTRIBUICAO', 'DDF', 'OUTLET', 'PREDILECTA', 'SALAO DE BELEZA', 'DESCONTINUADOS', 'SEM PASTA')\r\n                  THEN NVL(M.FAT_LIQUIDO_PASTA_3M, 0) ELSE 0 END)\r\n         AS NUMBER(20,6)) AS FAT_OUTRAS_PASTAS_3M\r\nFROM CLIENTES_ELEGIVEIS C\r\nLEFT JOIN MOVIMENTOS_PASTA M\r\n    ON M.CODIGOCLIENTE = C.CODCLI\r\nGROUP BY C.CODCLI\r\n),\r\nCLASSIFICACAO_CLIENTE AS (\r\n    SELECT\r\n        CLI.CODCLI AS CODIGOCLIENTE,\r\n        NVL(ATI.CODATIV, 0) AS CODRAM,\r\n        CASE\r\n            WHEN CLI.CODCLI IN (25638, 31182, 39488, 24489, 29470, 31045, 46157)\r\n                THEN 'DDD 94'\r\n            WHEN INSTR(UPPER(NVL(CID.DDD, 'ND')), 'DDD 91') > 0 THEN 'DDD 91'\r\n            WHEN INSTR(UPPER(NVL(CID.DDD, 'ND')), 'DDD 93') > 0 THEN 'DDD 93'\r\n            WHEN INSTR(UPPER(NVL(CID.DDD, 'ND')), 'DDD 94') > 0 THEN 'DDD 94'\r\n            ELSE 'OUTROS'\r\n        END AS DDD_GRUPO\r\n    FROM CLIENTES_ELEGIVEIS CLI\r\n    LEFT JOIN OKAJIMA.PCATIVI ATI ON ATI.CODATIV = CLI.CODATV1\r\n    LEFT JOIN OKAJIMA.PCCIDADE CID ON CID.CODCIDADE = CLI.CODCIDADE\r\n),\r\nPOTENCIAL_CLIENTE AS (\r\nSELECT\r\n    F.*,\r\n\r\n    CAST(\r\n        CASE WHEN P.DATA_INICIO < P.DATA_FIM THEN\r\n            AVG(F.FAT_LIQUIDO_TOTAL_3M) OVER (\r\n                PARTITION BY C.DDD_GRUPO, C.CODRAM\r\n            )\r\n        END AS NUMBER(20,6)\r\n    ) AS POTENCIAL_TOTAL_3M,\r\n    CAST(\r\n        CASE WHEN P.DATA_INICIO < P.DATA_FIM THEN\r\n            AVG(F.FAT_BU_DISTRIBUICAO_3M) OVER (\r\n                PARTITION BY C.DDD_GRUPO, C.CODRAM\r\n            )\r\n        END AS NUMBER(20,6)\r\n    ) AS POTENCIAL_BU_DISTRIBUICAO_3M,\r\n    CAST(\r\n        CASE WHEN P.DATA_INICIO < P.DATA_FIM THEN\r\n            AVG(F.FAT_BU_CGI_3M) OVER (\r\n                PARTITION BY C.DDD_GRUPO, C.CODRAM\r\n            )\r\n        END AS NUMBER(20,6)\r\n    ) AS POTENCIAL_BU_CGI_3M,\r\n    CAST(\r\n        CASE WHEN P.DATA_INICIO < P.DATA_FIM THEN\r\n            AVG(F.FAT_BU_PERFUMARIA_3M) OVER (\r\n                PARTITION BY C.DDD_GRUPO, C.CODRAM\r\n            )\r\n        END AS NUMBER(20,6)\r\n    ) AS POTENCIAL_BU_PERFUMARIA_3M\r\nFROM FAT_CLIENTE F\r\nINNER JOIN CLASSIFICACAO_CLIENTE C\r\n    ON C.CODIGOCLIENTE = F.CODIGOCLIENTE\r\nCROSS JOIN PARAMETROS P\r\n)\r\nSELECT\r\n    F.*,\r\n    CAST(ROUND(\r\n        CASE\r\n            WHEN F.POTENCIAL_TOTAL_3M IS NULL OR F.FAT_LIQUIDO_TOTAL_3M <= 0\r\n                THEN 0.50 * F.POTENCIAL_TOTAL_3M\r\n            WHEN F.FAT_LIQUIDO_TOTAL_3M >= F.POTENCIAL_TOTAL_3M THEN 1.05 * F.FAT_LIQUIDO_TOTAL_3M\r\n            ELSE F.FAT_LIQUIDO_TOTAL_3M + 0.50 * (F.POTENCIAL_TOTAL_3M - F.FAT_LIQUIDO_TOTAL_3M)\r\n        END, 2) AS NUMBER(20,2)) AS META_TOTAL_3M,\r\n    CAST(ROUND(\r\n        CASE\r\n            WHEN F.POTENCIAL_BU_DISTRIBUICAO_3M IS NULL OR F.FAT_BU_DISTRIBUICAO_3M <= 0\r\n                THEN 0.50 * F.POTENCIAL_BU_DISTRIBUICAO_3M\r\n            WHEN F.FAT_BU_DISTRIBUICAO_3M >= F.POTENCIAL_BU_DISTRIBUICAO_3M THEN 1.05 * F.FAT_BU_DISTRIBUICAO_3M\r\n            ELSE F.FAT_BU_DISTRIBUICAO_3M + 0.50 * (F.POTENCIAL_BU_DISTRIBUICAO_3M - F.FAT_BU_DISTRIBUICAO_3M)\r\n        END, 2) AS NUMBER(20,2)) AS META_BU_DISTRIBUICAO_3M,\r\n    CAST(ROUND(\r\n        CASE\r\n            WHEN F.POTENCIAL_BU_CGI_3M IS NULL OR F.FAT_BU_CGI_3M <= 0\r\n                THEN 0.50 * F.POTENCIAL_BU_CGI_3M\r\n            WHEN F.FAT_BU_CGI_3M >= F.POTENCIAL_BU_CGI_3M THEN 1.05 * F.FAT_BU_CGI_3M\r\n            ELSE F.FAT_BU_CGI_3M + 0.50 * (F.POTENCIAL_BU_CGI_3M - F.FAT_BU_CGI_3M)\r\n        END, 2) AS NUMBER(20,2)) AS META_BU_CGI_3M,\r\n    CAST(ROUND(\r\n        CASE\r\n            WHEN F.POTENCIAL_BU_PERFUMARIA_3M IS NULL OR F.FAT_BU_PERFUMARIA_3M <= 0\r\n                THEN 0.50 * F.POTENCIAL_BU_PERFUMARIA_3M\r\n            WHEN F.FAT_BU_PERFUMARIA_3M >= F.POTENCIAL_BU_PERFUMARIA_3M THEN 1.05 * F.FAT_BU_PERFUMARIA_3M\r\n            ELSE F.FAT_BU_PERFUMARIA_3M + 0.50 * (F.POTENCIAL_BU_PERFUMARIA_3M - F.FAT_BU_PERFUMARIA_3M)\r\n        END, 2) AS NUMBER(20,2)) AS META_BU_PERFUMARIA_3M\r\nFROM POTENCIAL_CLIENTE F",
											"partitionOption": "None",
											"queryTimeout": "00:30:00"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ds_oracle_dynamic",
											"type": "DatasetReference",
											"parameters": {
												"SchemaName": {
													"value": "@pipeline().parameters.SchemaName",
													"type": "Expression"
												},
												"TableName": {
													"value": "@item().SourceView",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls_dynamic",
											"type": "DatasetReference",
											"parameters": {
												"Directory": {
													"value": "@concat(pipeline().parameters.SinkDirectoryRoot, '/', item().SinkFolder)",
													"type": "Expression"
												},
												"FileName": {
													"value": "@item().SinkFileName",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"TableConfigurations": {
						"type": "array",
						"defaultValue": [
							{
								"SourceView": "OKJ_POTENCIAL_FATURAMENTO_PDV_PBI",
								"SinkFolder": "Potencial_pbi",
								"SinkFileName": "Potencial_pbi.parquet",
								"QueryOverride": ""
							}
						]
					},
					"SinkDirectoryRoot": {
						"type": "string",
						"defaultValue": "fatos"
					},
					"SchemaName": {
						"type": "string",
						"defaultValue": "OKAJIMA"
					}
				},
				"folder": {
					"name": "dimensoes/prod"
				},
				"annotations": [],
				"lastPublishTime": "2026-02-10T16:23:10Z"
			},
			"dependsOn": []
		},
