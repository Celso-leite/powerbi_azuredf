{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nome do Data Factory",
			"defaultValue": "adf-okajima"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_potencial_Rota_oracle_adls')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "ForEach_Potencial_Rotas",
						"type": "ForEach",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@pipeline().parameters.TableConfigurations",
								"type": "Expression"
							},
							"isSequential": false,
							"batchCount": 5,
							"activities": [
								{
									"name": "Copy_Oracle_to_ADLS",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.01:30:00",
										"retry": 2,
										"retryIntervalInSeconds": 60,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "OracleSource",
											"oracleReaderQuery": "WITH PARAMETROS AS (\n    SELECT GREATEST(\n               TRUNC(SYSDATE, 'YYYY'),\n               ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -3)\n           ) AS DATA_INICIO,\n           TRUNC(SYSDATE, 'MM') AS DATA_FIM\n    FROM DUAL\n),\nFATURAMENTO_BASE AS (\n  SELECT\n    PCMOV.CODCLI AS CODIGOCLIENTE,\n    PCPRODUT.CODFORNEC AS CODIGOFORNECEDOR,\n    CAST(NVL(RCA_OFC.CODUSUR_OFC,\n         NVL(PCMOV.RCAVENDA, PCMOV.CODUSUR)) AS NUMERIC(16,0)) AS CODIGORCAVENDA,\n    CAST(\n        NVL(\n            NVL(ROUND(PCMOVCOMPLE.VLSUBTOTITEM, 2), -- Lógica simplificada aqui\n            (ROUND(\n                (DECODE(PCMOV.CODOPER,\n                        'S', (NVL(DECODE(PCNFSAID.CONDVENDA, 7, DECODE(NVL(PCMOV.TIPOITEM, 'C'), 'C', PCMOV.QT, PCMOV.QTCONT), PCMOV.QT), 0)),\n                        'ST', (NVL(DECODE(PCNFSAID.CONDVENDA, 7, DECODE(NVL(PCMOV.TIPOITEM, 'C'), 'C', PCMOV.QT, PCMOV.QTCONT), PCMOV.QT), 0)),\n                        'SM', (NVL(DECODE(PCNFSAID.CONDVENDA, 7, DECODE(NVL(PCMOV.TIPOITEM, 'C'), 'C', PCMOV.QT, PCMOV.QTCONT), PCMOV.QT), 0)),\n                        0))\n                * ((NVL(\n                        DECODE(\n                        PCNFSAID.CONDVENDA\n                        , 7, DECODE(NVL(PCMOV.TIPOITEM, 'C'), 'C', NVL(PCMOV.PUNIT, 0), PCMOV.PUNITCONT) + NVL(PCMOV.VLFRETE, 0) + NVL(PCMOV.VLOUTRASDESP, 0) + NVL(PCMOV.VLFRETE_RATEIO, 0) + NVL(PCMOV.VLOUTROS, 0)\n                        , NVL(PCMOV.PUNIT, 0) + NVL(PCMOV.VLFRETE, 0) + NVL(PCMOV.VLOUTRASDESP, 0) + NVL(PCMOV.VLFRETE_RATEIO, 0) + NVL(PCMOV.VLOUTROS, 0))\n                    , 0))\n                    - NVL(PCMOV.VLIPI, 0)\n                    - NVL(PCMOV.ST, 0))\n            , 2))\n            + ROUND(\n                NVL(PCMOV.VLIPI, 0) * (DECODE(PCMOV.CODOPER,\n                        'S', (NVL(DECODE(PCNFSAID.CONDVENDA, 7, DECODE(NVL(PCMOV.TIPOITEM, 'C'), 'C', PCMOV.QT, PCMOV.QTCONT), PCMOV.QT), 0)),\n                        'ST', (NVL(DECODE(PCNFSAID.CONDVENDA, 7, DECODE(NVL(PCMOV.TIPOITEM, 'C'), 'C', PCMOV.QT, PCMOV.QTCONT), PCMOV.QT), 0)),\n                        'SM', (NVL(DECODE(PCNFSAID.CONDVENDA, 7, DECODE(NVL(PCMOV.TIPOITEM, 'C'), 'C', PCMOV.QT, PCMOV.QTCONT), PCMOV.QT), 0)),\n                        0))\n            , 2)\n            + ROUND(\n                NVL(PCMOV.ST, 0) * (DECODE(PCMOV.CODOPER,\n                        'S', (NVL(DECODE(PCNFSAID.CONDVENDA, 7, DECODE(NVL(PCMOV.TIPOITEM, 'C'), 'C', PCMOV.QT, PCMOV.QTCONT), PCMOV.QT), 0)),\n                        'ST', (NVL(DECODE(PCNFSAID.CONDVENDA, 7, DECODE(NVL(PCMOV.TIPOITEM, 'C'), 'C', PCMOV.QT, PCMOV.QTCONT), PCMOV.QT), 0)),\n                        'SM', (NVL(DECODE(PCNFSAID.CONDVENDA, 7, DECODE(NVL(PCMOV.TIPOITEM, 'C'), 'C', PCMOV.QT, PCMOV.QTCONT), PCMOV.QT), 0)),\n                        0))\n            , 2))\n        , 0)\n    AS NUMERIC(18,6)) AS VALORTOTAL_CALCULADO\n  FROM OKAJIMA.PCNFSAID\n    INNER JOIN OKAJIMA.PCPLPAG ON PCPLPAG.CODPLPAG = PCNFSAID.CODPLPAG\n    INNER JOIN OKAJIMA.PCMOV ON PCNFSAID.NUMNOTA = PCMOV.NUMNOTA AND PCNFSAID.NUMTRANSVENDA = PCMOV.NUMTRANSVENDA\n    INNER JOIN OKAJIMA.PCPRODUT ON PCMOV.CODPROD = PCPRODUT.CODPROD\n    LEFT JOIN OKAJIMA.PCMOVCOMPLE ON PCMOV.NUMTRANSITEM = PCMOVCOMPLE.NUMTRANSITEM\n    LEFT JOIN LATERAL (\n        SELECT MIN(I.CODUSUR_OFC) AS CODUSUR_OFC\n        FROM OKAJIMA.PCPEDI I\n        WHERE I.NUMPED = PCMOV.NUMPED\n          AND I.CODPROD = PCMOV.CODPROD\n          AND I.CODUSUR_OFC IS NOT NULL\n    ) RCA_OFC ON 1 = 1\n    CROSS JOIN PARAMETROS P\n  WHERE\n    NVL(PCNFSAID.TIPOVENDA, 'X') NOT IN ('SR', 'DF')\n    AND PCNFSAID.DTCANCEL IS NULL\n    AND NVL(PCMOV.TIPOITEM, 'C') IN ('C', 'N')\n    AND PCNFSAID.CODFISCAL <> 0\n    AND PCNFSAID.CODFISCAL NOT IN (722, 532, 632, 732)\n    AND PCNFSAID.CONDVENDA NOT IN (0, 4, 8, 10, 13, 20, 98, 99)\n    AND PCNFSAID.CODCLI NOT IN (247, 24805, 29828, 24806, 31134)\n    AND PCNFSAID.DTSAIDA >= P.DATA_INICIO\n    AND PCNFSAID.DTSAIDA <  P.DATA_FIM\n    AND PCMOV.CODFILIAL IN ('2', '3')\n),\nMOVIMENTOS_FORNECEDOR AS (\n    SELECT\n        F.CODIGOCLIENTE,\n        F.CODIGOFORNECEDOR,\n        SUM(NVL(F.VALORTOTAL_CALCULADO, 0)) AS VALOR_LIQUIDO\n    FROM FATURAMENTO_BASE F\n    LEFT JOIN OKAJIMA.OKA_ROTAS_VW R\n      ON R.CODUSUR = F.CODIGORCAVENDA\n     AND R.CODCLI = F.CODIGOCLIENTE\n     AND R.CODFORNEC = F.CODIGOFORNECEDOR\n    WHERE F.CODIGORCAVENDA NOT IN (325, 4119, 4668, 7305)\n       OR F.CODIGORCAVENDA IS NULL\n    GROUP BY F.CODIGOCLIENTE, F.CODIGOFORNECEDOR\n\n    UNION ALL\n\n    SELECT\n        D.CODIGOCLIENTE,\n        D.CODIGOFORNECEDOR,\n        -SUM(NVL(D.VALORTOTAL, 0)) AS VALOR_LIQUIDO\n    FROM OKAJIMA.OKJ_FATODEVOLUCAO_PBI D\n    CROSS JOIN PARAMETROS P\n    WHERE D.DATADEVOLUCAO >= P.DATA_INICIO\n      AND D.DATADEVOLUCAO <  P.DATA_FIM\n      AND D.CODIGOFILIAL IN ('2', '3')\n      AND (D.CODIGORCAVENDA NOT IN (325, 4119, 4668, 7305)\n           OR D.CODIGORCAVENDA IS NULL)\n    GROUP BY D.CODIGOCLIENTE, D.CODIGOFORNECEDOR\n),\nFATURAMENTO_CLIENTE_PASTA AS (\n    SELECT M.CODIGOCLIENTE,\n           NVL(TRIM(F.PASTA_CAMPANHA), 'SEM PASTA') AS PASTA,\n           ROUND(SUM(M.VALOR_LIQUIDO), 2) AS FATURAMENTO_LIQUIDO_3M\n    FROM MOVIMENTOS_FORNECEDOR M\n    LEFT JOIN OKAJIMA.OKJ_DIMFORNECEDOR_PBI F\n      ON F.CODIGO_FORNECEDOR = M.CODIGOFORNECEDOR\n    GROUP BY M.CODIGOCLIENTE,\n             NVL(TRIM(F.PASTA_CAMPANHA), 'SEM PASTA')\n),\nCLIENTES AS (\n    SELECT C.CODIGOCLIENTE,\n           C.CODIGORAMOATIVIDADE AS CODRAM,\n           NVL(TRIM(C.RAMOATIVIDADE), 'NAO INFORMADO') AS RAMOATIVIDADE,\n           CASE\n             WHEN INSTR(UPPER(C.DDD_CANAL), 'DDD 91') > 0 THEN 'DDD 91'\n             WHEN INSTR(UPPER(C.DDD_CANAL), 'DDD 93') > 0 THEN 'DDD 93'\n             WHEN INSTR(UPPER(C.DDD_CANAL), 'DDD 94') > 0 THEN 'DDD 94'\n             ELSE 'OUTROS'\n           END AS DDD\n    FROM OKAJIMA.OKJ_DIMCLIENTE_PBI C\n)\nSELECT /*+ GATHER_PLAN_STATISTICS */ /* POTENCIAL_3M_CANDIDATA */\n       CAST(C.CODRAM AS NUMBER(16,0)) AS CODRAM,\n       C.RAMOATIVIDADE, C.DDD, F.PASTA,\n       CAST(COUNT(*) AS NUMBER(16,0)) AS QT_CLIENTE,\n       CAST(ROUND(SUM(F.FATURAMENTO_LIQUIDO_3M), 2)\n            AS NUMBER(18,2)) AS FAT_3_MESES,\n       CAST(ROUND(AVG(F.FATURAMENTO_LIQUIDO_3M), 2)\n            AS NUMBER(18,2)) AS MEDIA_FAT_3_MESES\nFROM FATURAMENTO_CLIENTE_PASTA F\nINNER JOIN CLIENTES C ON C.CODIGOCLIENTE = F.CODIGOCLIENTE\nGROUP BY C.CODRAM, C.RAMOATIVIDADE, C.DDD, F.PASTA",
											"partitionOption": "None",
											"queryTimeout": "00:30:00"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ds_oracle_dynamic",
											"type": "DatasetReference",
											"parameters": {
												"SchemaName": {
													"value": "@pipeline().parameters.SchemaName",
													"type": "Expression"
												},
												"TableName": {
													"value": "@item().SourceView",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls_dynamic",
											"type": "DatasetReference",
											"parameters": {
												"Directory": {
													"value": "@concat(pipeline().parameters.SinkDirectoryRoot, '/', item().SinkFolder)",
													"type": "Expression"
												},
												"FileName": {
													"value": "@item().SinkFileName",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"TableConfigurations": {
						"type": "array",
						"defaultValue": [
							{
								"SourceView": "OKJ_POTENCIAL_FATURAMENTO_PDV_PBI",
								"SinkFolder": "Potencial_pbi",
								"SinkFileName": "Potencial_pbi.parquet",
								"QueryOverride": ""
							}
						]
					},
					"SinkDirectoryRoot": {
						"type": "string",
						"defaultValue": "fatos"
					},
					"SchemaName": {
						"type": "string",
						"defaultValue": "OKAJIMA"
					}
				},
				"folder": {
					"name": "dimensoes/prod"
				},
				"annotations": [],
				"lastPublishTime": "2026-02-10T16:23:10Z"
			},
			"dependsOn": []
		},
