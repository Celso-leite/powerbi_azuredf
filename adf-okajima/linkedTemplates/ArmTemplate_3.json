												"type": "Expression"
											},
											"SinkDirectoryRoot": {
												"value": "@pipeline().parameters.SinkDirectoryRoot",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"SchemaName": {
						"type": "string",
						"defaultValue": "OKAJIMA"
					},
					"SinkDirectoryRoot": {
						"type": "string",
						"defaultValue": "fatos"
					},
					"AnomesList": {
