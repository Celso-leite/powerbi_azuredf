													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"dataset": {
														"referenceName": "dw_fatos_ofc_full",
														"type": "DatasetReference",
														"parameters": {
															"tabela": {
																"value": "@item().tableName",
																"type": "Expression"
															}
														}
													},
													"enableLogging": false,
													"storeSettings": {
														"type": "AzureBlobFSWriteSettings",
														"recursive": true
													}
												}
											},
											{
												"name": "Copy_Full_Load",
												"type": "Copy",
												"dependsOn": [
													{
														"activity": "Delete_Full_Load_Folder",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 1,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "PostgreSqlV2Source",
														"query": {
															"value": "@concat('SELECT * FROM public.', item().tableName)",
															"type": "Expression"
														}
													},
													"sink": {
														"type": "ParquetSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "ParquetWriteSettings"
														}
													},
													"enableStaging": false
												},
												"inputs": [
													{
														"referenceName": "Tabelas_fatos_supabase",
														"type": "DatasetReference",
														"parameters": {
