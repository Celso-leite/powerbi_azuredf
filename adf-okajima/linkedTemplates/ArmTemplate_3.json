{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nome do Data Factory",
			"defaultValue": "adf-okajima"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_fatos')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "ForEach_Table",
						"type": "ForEach",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@variables('table_configurations')",
								"type": "Expression"
							},
							"isSequential": false,
							"activities": [
								{
									"name": "Switch_Load_Mode",
									"type": "Switch",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"on": {
											"value": "@concat(item().loadType, '|', toLower(string(item().usePublicationControl)))",
											"type": "Expression"
										},
										"cases": [
											{
												"value": "full|false",
												"activities": [
													{
														"name": "Delete_Full_Load_Folder",
														"type": "Delete",
														"dependsOn": [],
														"policy": {
															"timeout": "0.12:00:00",
															"retry": 1,
															"retryIntervalInSeconds": 30,
															"secureOutput": false,
															"secureInput": false
														},
														"userProperties": [],
														"typeProperties": {
															"dataset": {
																"referenceName": "dw_fatos_ofc_full",
																"type": "DatasetReference",
																"parameters": {
																	"tabela": {
																		"value": "@item().tableName",
																		"type": "Expression"
																	}
																}
															},
															"enableLogging": false,
															"storeSettings": {
																"type": "AzureBlobFSWriteSettings",
																"recursive": true
															}
														}
													},
													{
														"name": "Copy_Full_Load",
														"type": "Copy",
														"dependsOn": [
															{
																"activity": "Delete_Full_Load_Folder",
																"dependencyConditions": [
																	"Succeeded"
																]
															}
														],
														"policy": {
															"timeout": "0.12:00:00",
															"retry": 1,
															"retryIntervalInSeconds": 30,
															"secureOutput": false,
															"secureInput": false
														},
														"userProperties": [],
														"typeProperties": {
															"source": {
																"type": "PostgreSqlV2Source",
																"query": {
																	"value": "@concat('SELECT * FROM public.', item().tableName)",
																	"type": "Expression"
																}
															},
															"sink": {
																"type": "ParquetSink",
																"storeSettings": {
																	"type": "AzureBlobFSWriteSettings"
																},
																"formatSettings": {
																	"type": "ParquetWriteSettings"
																}
															},
															"enableStaging": false
														},
														"inputs": [
															{
																"referenceName": "Tabelas_fatos_supabase",
																"type": "DatasetReference",
																"parameters": {
																	"tabela": {
																		"value": "@item().tableName",
																		"type": "Expression"
																	}
																}
															}
														],
														"outputs": [
															{
																"referenceName": "dw_fatos_ofc_full",
																"type": "DatasetReference",
																"parameters": {
																	"tabela": {
																		"value": "@item().tableName",
																		"type": "Expression"
																	}
																}
															}
														]
													}
												]
											},
											{
												"value": "incremental|true",
												"activities": [
													{
														"name": "Lookup_Publication_State",
														"type": "Lookup",
														"dependsOn": [],
														"policy": {
															"timeout": "0.12:00:00",
															"retry": 0,
															"retryIntervalInSeconds": 30,
															"secureOutput": false,
															"secureInput": false
														},
														"userProperties": [],
														"typeProperties": {
															"source": {
																"type": "PostgreSqlV2Source",
																"query": {
																	"value": "@concat('SELECT e.entity_name, COALESCE(p.status, ''MISSING'') AS status, COALESCE(p.publication_version, 0) AS publication_version, p.run_id, p.target_ref, COALESCE(c.last_consumed_version, 0) AS last_consumed_version, CASE WHEN p.status = ''SUCCESS'' AND COALESCE(p.publication_version, 0) > COALESCE(c.last_consumed_version, 0) THEN 1 ELSE 0 END AS should_copy FROM (SELECT ''', item().entityName, '''::text AS entity_name) e LEFT JOIN public.etl_publication_control p ON p.entity_name = e.entity_name LEFT JOIN public.etl_consumer_control c ON c.consumer_name = ''adf_powerbi'' AND c.entity_name = e.entity_name')",
																	"type": "Expression"
																}
															},
															"dataset": {
																"referenceName": "ds_supabase_etl_control",
																"type": "DatasetReference",
																"parameters": {}
															},
															"firstRowOnly": true
														}
													},
													{
														"name": "If_Should_Copy",
														"type": "IfCondition",
														"dependsOn": [
															{
																"activity": "Lookup_Publication_State",
																"dependencyConditions": [
																	"Succeeded"
																]
															}
														],
														"userProperties": [],
														"typeProperties": {
															"expression": {
																"value": "@equals(string(activity('Lookup_Publication_State').output.firstRow.should_copy), '1')",
																"type": "Expression"
															},
															"ifTrueActivities": [
																{
																	"name": "Execute_Incremental_Load_Pipeline",
																	"type": "ExecutePipeline",
																	"dependsOn": [],
																	"policy": {
																		"secureInput": false
																	},
																	"userProperties": [],
																	"typeProperties": {
																		"pipeline": {
																			"referenceName": "pl_fatos_process_incremental_partitions",
																			"type": "PipelineReference"
																		},
																		"waitOnCompletion": true,
																		"parameters": {
																			"tableName": {
																				"value": "@item().tableName",
																				"type": "Expression"
																			},
																			"anomesColumn": {
																				"value": "@item().anomesColumn",
																				"type": "Expression"
																			},
																			"anomesList": {
																				"value": "@split(activity('Lookup_Publication_State').output.firstRow.target_ref, ',')",
																				"type": "Expression"
																			}
																		}
																	}
																},
																{
																	"name": "Lookup_Update_Consumer_Control",
																	"type": "Lookup",
																	"dependsOn": [
																		{
																			"activity": "Execute_Incremental_Load_Pipeline",
																			"dependencyConditions": [
																				"Succeeded"
																			]
																		}
																	],
																	"policy": {
																		"timeout": "0.12:00:00",
																		"retry": 0,
																		"retryIntervalInSeconds": 30,
																		"secureOutput": false,
																		"secureInput": false
																	},
																	"userProperties": [],
																	"typeProperties": {
																		"source": {
																			"type": "PostgreSqlV2Source",
																			"query": {
																				"value": "@concat('SELECT public.sp_atualizar_etl_consumer_control(''adf_powerbi'', ''', item().entityName, ''', ', string(activity('Lookup_Publication_State').output.firstRow.publication_version), ', ''', activity('Lookup_Publication_State').output.firstRow.run_id, ''', ''SUCCESS'') AS last_consumed_version')",
																				"type": "Expression"
																			}
																		},
																		"dataset": {
																			"referenceName": "ds_supabase_etl_consumer_control",
																			"type": "DatasetReference",
																			"parameters": {}
																		},
																		"firstRowOnly": true
																	}
																}
															]
														}
													}
												]
											},
											{
												"value": "incremental|false",
												"activities": [
													{
														"name": "Lookup_Get_Anomes_Legacy",
														"type": "Lookup",
														"dependsOn": [],
														"policy": {
															"timeout": "0.12:00:00",
															"retry": 0,
															"retryIntervalInSeconds": 30,
															"secureOutput": false,
															"secureInput": false
														},
														"userProperties": [],
														"typeProperties": {
															"source": {
																"type": "PostgreSqlV2Source",
																"query": {
																	"value": "@concat('SELECT TO_CHAR(datum, ''YYYYMM'') AS anomes FROM generate_series(DATE_TRUNC(''month'', CURRENT_DATE) - (', string(sub(item().monthsToProcess, 1)), ' || '' months'')::interval, DATE_TRUNC(''month'', CURRENT_DATE), ''1 month'') AS datum')",
																	"type": "Expression"
																}
															},
															"dataset": {
																"referenceName": "ds_controle_meses_incrementais",
																"type": "DatasetReference",
																"parameters": {}
															},
															"firstRowOnly": false
														}
													},
													{
														"name": "Execute_Incremental_Load_Pipeline_Legacy",
														"type": "ExecutePipeline",
														"dependsOn": [
															{
																"activity": "Lookup_Get_Anomes_Legacy",
																"dependencyConditions": [
																	"Succeeded"
																]
															}
														],
														"policy": {
															"secureInput": false
														},
														"userProperties": [],
														"typeProperties": {
															"pipeline": {
																"referenceName": "pl_fatos_process_incremental_partitions",
																"type": "PipelineReference"
															},
															"waitOnCompletion": true,
															"parameters": {
																"tableName": {
																	"value": "@item().tableName",
																	"type": "Expression"
																},
																"anomesColumn": {
																	"value": "@item().anomesColumn",
																	"type": "Expression"
																},
																"anomesList": {
																	"value": "@activity('Lookup_Get_Anomes_Legacy').output.value",
																	"type": "Expression"
																}
															}
														}
													}
												]
											}
										]
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"table_configurations": {
						"type": "Array",
						"defaultValue": [
							{
								"tableName": "fatofaturamento_pbi",
								"entityName": "fatofaturamento_pbi",
								"anomesColumn": "anomes_faturamento",
								"monthsToProcess": 1,
								"loadType": "incremental",
								"usePublicationControl": true
							},
							{
								"tableName": "fatodevolucao_pbi",
								"entityName": "fatodevolucao_pbi",
								"anomesColumn": "anomes_devolucao",
								"monthsToProcess": 1,
								"loadType": "incremental",
								"usePublicationControl": true
							},
							{
								"tableName": "fatopedidovenda_pbi",
								"entityName": "fatopedidovenda_pbi",
								"anomesColumn": "anomes_venda",
								"monthsToProcess": 1,
								"loadType": "incremental",
								"usePublicationControl": true
							},
							{
								"tableName": "map_venda_devolucao_pbi",
								"entityName": "map_venda_devolucao_pbi",
								"anomesColumn": "",
								"monthsToProcess": 0,
								"loadType": "full",
								"usePublicationControl": false
							}
						]
					}
				},
				"folder": {
					"name": "fatos"
				},
				"annotations": [],
				"lastPublishTime": "2026-02-02T14:26:03Z"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_fatos_copy1')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
