{
	"name": "pl_positivakc_oracle_adls",
	"properties": {
		"activities": [
			{
				"name": "ForEach_PositivaKC",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.Tabelas_PositivaKC",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "Copy_Oracle_to_ADLS",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:30:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "OracleSource",
									"partitionOption": "None",
									"queryTimeout": "00:30:00"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_oracle_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"SchemaName": {
											"value": "@pipeline().parameters.SchemaName",
											"type": "Expression"
										},
										"TableName": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"Directory": {
											"value": "@concat(pipeline().parameters.SinkDirectoryRoot, '/', toLower(replace(item(), 'OKJ_', '')))",
											"type": "Expression"
										},
										"FileName": {
											"value": "@concat(toLower(item()), '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"Tabelas_PositivaKC": {
				"type": "array",
				"defaultValue": [
					"OKJ_POSITIVAKC_RESULTADOS",
					"OKJ_POSITIVAKC_INDICADORES"
				]
			},
			"SinkDirectoryRoot": {
				"type": "string",
				"defaultValue": "positivakc"
			},
			"SchemaName": {
				"type": "string",
				"defaultValue": "OKAJIMA"
			}
		},
		"folder": {
			"name": "positiva_kc"
		},
		"annotations": [],
		"lastPublishTime": "2026-01-14T20:53:25Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}