{
	"name": "pl_fatos",
	"properties": {
		"activities": [
			{
				"name": "ForEach_Table",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('table_configurations')",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "If_Load_Type",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().loadType, 'full')",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Lookup_Get_Anomes",
										"type": "Lookup",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "PostgreSqlV2Source",
												"query": {
													"value": "@concat('SELECT TO_CHAR(datum, ''YYYYMM'') AS anomes FROM generate_series(DATE_TRUNC(''month'', CURRENT_DATE) - (', string(sub(item().monthsToProcess, 1)), ' || '' months'')::interval, DATE_TRUNC(''month'', CURRENT_DATE), ''1 month'') AS datum')",
													"type": "Expression"
												}
											},
											"dataset": {
												"referenceName": "ds_controle_meses_incrementais",
												"type": "DatasetReference"
											},
											"firstRowOnly": false
										}
									},
									{
										"name": "Execute_Incremental_Load_Pipeline",
										"type": "ExecutePipeline",
										"dependsOn": [
											{
												"activity": "Lookup_Get_Anomes",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "pl_fatos_process_incremental_partitions",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"tableName": {
													"value": "@item().tableName",
													"type": "Expression"
												},
												"anomesColumn": {
													"value": "@item().anomesColumn",
													"type": "Expression"
												},
												"anomesList": {
													"value": "@activity('Lookup_Get_Anomes').output.value",
													"type": "Expression"
												}
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Delete_Full_Load_Folder",
										"type": "Delete",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 1,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataset": {
												"referenceName": "dw_fatos_ofc_full",
												"type": "DatasetReference",
												"parameters": {
													"tabela": {
														"value": "@item().tableName",
														"type": "Expression"
													}
												}
											},
											"enableLogging": false,
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings",
												"recursive": true
											}
										}
									},
									{
										"name": "Copy_Full_Load",
										"type": "Copy",
										"dependsOn": [
											{
												"activity": "Delete_Full_Load_Folder",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 1,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "PostgreSqlV2Source",
												"query": {
													"value": "@concat('SELECT * FROM public.', item().tableName)",
													"type": "Expression"
												}
											},
											"sink": {
												"type": "ParquetSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "ParquetWriteSettings"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "Tabelas_fatos_supabase",
												"type": "DatasetReference",
												"parameters": {
													"tabela": {
														"value": "@item().tableName",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "dw_fatos_ofc_full",
												"type": "DatasetReference",
												"parameters": {
													"tabela": {
														"value": "@item().tableName",
														"type": "Expression"
													}
												}
											}
										]
									}
								]
							}
						}
					]
				}
			}
		],
		"variables": {
			"table_configurations": {
				"type": "Array",
				"defaultValue": [
					{
						"tableName": "fatofaturamento_pbi",
						"anomesColumn": "anomes_faturamento",
						"monthsToProcess": 1,
						"loadType": "incremental"
					},
					{
						"tableName": "fatodevolucao_pbi",
						"anomesColumn": "anomes_devolucao",
						"monthsToProcess": 1,
						"loadType": "incremental"
					},
					{
						"tableName": "fatopedidovenda_pbi",
						"anomesColumn": "anomes_venda",
						"monthsToProcess": 1,
						"loadType": "incremental"
					},
					{
						"tableName": "map_venda_devolucao_pbi",
						"anomesColumn": "",
						"monthsToProcess": 0,
						"loadType": "full"
					}
				]
			}
		},
		"folder": {
			"name": "fatos"
		},
		"annotations": [],
		"lastPublishTime": "2026-02-02T14:26:03Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}