{
	"name": "pl_campanhas_okajima_oracle_adls",
	"properties": {
		"activities": [
			{
				"name": "ForEach_Catalogo_Campanhas",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.TableConfigurations",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 2,
					"activities": [
						{
							"name": "Copy_Oracle_to_ADLS",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:30:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "OracleSource",
									"oracleReaderQuery": {
										"value": "@concat('SELECT ', join(item().Columns, ', '), ' FROM ', pipeline().parameters.SchemaName, '.', item().TableName)",
										"type": "Expression"
									},
									"partitionOption": "None",
									"queryTimeout": "00:30:00"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings",
										"compressionCodec": "snappy"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_oracle_query_consulting",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_dynamic_okj",
									"type": "DatasetReference",
									"parameters": {
										"Directory": {
											"value": "@concat(item().SinkDirectoryRoot, '/', item().SinkTableName)",
											"type": "Expression"
										},
										"FileName": {
											"value": "@concat(toLower(item().TableName), '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"SchemaName": {
				"type": "string",
				"defaultValue": "OKAJIMA"
			},
			"TableConfigurations": {
				"type": "array",
				"defaultValue": [
					{
						"TableName": "OKJ_CAMPANHASC",
						"SinkDirectoryRoot": "dimensoes",
						"SinkTableName": "okj_campanhasc",
						"Columns": [
							"CODCAMP",
							"DESCRICAO",
							"PERIODO",
							"ATIVA",
							"DT_INICIO",
							"DT_FIM"
						]
					},
					{
						"TableName": "OKJ_CAMPANHASI",
						"SinkDirectoryRoot": "dimensoes",
						"SinkTableName": "okj_campanhasi",
						"Columns": [
							"CODCAMP",
							"CODIND",
							"DESCRICAO",
							"DT_INICIO",
							"DT_FIM"
						]
					}
				]
			}
		},
		"folder": {
			"name": "dimensoes/prod"
		},
		"annotations": [],
		"description": "Copia o cadastro de campanhas e seus indicadores do Oracle WINT para arquivos Parquet em dimensoes."
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
