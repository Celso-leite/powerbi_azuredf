{
	"name": "pl_dimensoes_incremental",
	"properties": {
		"activities": [
			{
				"name": "ForEach_Table",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('table_configurations')",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "If_Load_Type",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().loadType, 'full')",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Lookup_Get_Anomes",
										"type": "Lookup",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "PostgreSqlV2Source",
												"query": {
													"value": "@concat('SELECT DISTINCT ', item().anomesColumn, ' AS anomes FROM ', item().tableName, ' WHERE ', item().anomesColumn, ' BETWEEN TO_CHAR(DATE_TRUNC(''month'', (CURRENT_TIMESTAMP AT TIME ZONE ''America/Sao_Paulo'')::date) - (', string(sub(item().monthsToProcess, 1)), ' || '' months'')::interval, ''YYYYMM'') AND TO_CHAR(DATE_TRUNC(''month'', (CURRENT_TIMESTAMP AT TIME ZONE ''America/Sao_Paulo'')::date), ''YYYYMM'') ORDER BY 1')",
													"type": "Expression"
												}
											},
											"dataset": {
												"referenceName": "ds_controle_meses_incrementais",
												"type": "DatasetReference"
											},
											"firstRowOnly": false
										}
									},
									{
										"name": "Execute_Incremental_Load_Pipeline",
										"type": "ExecutePipeline",
										"dependsOn": [
											{
												"activity": "Lookup_Get_Anomes",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "pl_dimensoes_process_incremental_partitions",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"tableName": {
													"value": "@item().tableName",
													"type": "Expression"
												},
												"anomesColumn": {
													"value": "@item().anomesColumn",
													"type": "Expression"
												},
												"anomesList": {
													"value": "@activity('Lookup_Get_Anomes').output.value",
													"type": "Expression"
												},
												"fileSystem": {
													"value": "@pipeline().parameters.fileSystem",
													"type": "Expression"
												}
											}
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"fileSystem": {
				"type": "string",
				"defaultValue": "powerbi"
			}
		},
		"variables": {
			"table_configurations": {
				"type": "Array",
				"defaultValue": [
					{
						"tableName": "public.dimcabecalhopedidovenda_pbi",
						"anomesColumn": "TO_CHAR(datavenda, 'YYYYMM')",
						"monthsToProcess": 6,
						"loadType": "incremental"
					}
				]
			}
		},
		"folder": {
			"name": "dimensoes/prod"
		},
		"annotations": [],
		"lastPublishTime": "2026-02-10T13:28:24Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
