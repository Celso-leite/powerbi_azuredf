{
	"name": "pl_fatopromocaodesconto_full_2026",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Anomes_2026",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "OracleSource",
						"oracleReaderQuery": {
							"value": "@concat('SELECT DISTINCT CAST(ANOMES_VENDA AS VARCHAR2(6)) AS ANOMES_VENDA FROM ', pipeline().parameters.SchemaName, '.OKJ_FATOPROMOCAODESCONTO_PBI WHERE ANOMES_VENDA >= ''', pipeline().parameters.StartAnomes, ''' AND ANOMES_VENDA < ''', pipeline().parameters.EndAnomesExclusive, ''' ORDER BY 1')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_oracle_query_consulting",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Anomes",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Anomes_2026",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_Anomes_2026').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Delete_Anomes_File",
							"type": "Delete",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 1,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "ds_adls_dynamic_okj",
									"type": "DatasetReference",
									"parameters": {
										"Directory": {
											"value": "@concat(pipeline().parameters.SinkDirectoryRoot, '/fatopromocaodesconto_pbi')",
											"type": "Expression"
										},
										"FileName": {
											"value": "@concat('okj_fatopromocaodesconto_pbi_', item().ANOMES_VENDA, '.parquet')",
											"type": "Expression"
										}
									}
								},
								"enableLogging": false,
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings",
									"recursive": true
								}
							}
						},
						{
							"name": "Copy_Oracle_to_ADLS_Anomes",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Delete_Anomes_File",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.01:30:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "OracleSource",
									"oracleReaderQuery": {
										"value": "@concat('SELECT * FROM ', pipeline().parameters.SchemaName, '.OKJ_FATOPROMOCAODESCONTO_PBI WHERE DATAVENDA >= TO_DATE(''', item().ANOMES_VENDA, ''', ''YYYYMM'') AND DATAVENDA < ADD_MONTHS(TO_DATE(''', item().ANOMES_VENDA, ''', ''YYYYMM''), 1)')",
										"type": "Expression"
									},
									"partitionOption": "None",
									"queryTimeout": "00:30:00"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings",
										"compressionCodec": "snappy"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_oracle_query_consulting",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_dynamic_okj",
									"type": "DatasetReference",
									"parameters": {
										"Directory": {
											"value": "@concat(pipeline().parameters.SinkDirectoryRoot, '/fatopromocaodesconto_pbi')",
											"type": "Expression"
										},
										"FileName": {
											"value": "@concat('okj_fatopromocaodesconto_pbi_', item().ANOMES_VENDA, '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"SchemaName": {
				"type": "string",
				"defaultValue": "OKAJIMA"
			},
			"SinkDirectoryRoot": {
				"type": "string",
				"defaultValue": "fatos"
			},
			"StartAnomes": {
				"type": "string",
				"defaultValue": "202601"
			},
			"EndAnomesExclusive": {
				"type": "string",
				"defaultValue": "202701"
			}
		},
		"folder": {
			"name": "fatopromocaodesconto"
		},
		"annotations": []
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
