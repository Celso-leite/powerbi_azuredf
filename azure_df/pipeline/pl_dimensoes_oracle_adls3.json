{
	"name": "pl_dimensoes_oracle_adls3",
	"properties": {
		"activities": [
			{
				"name": "ForEach_Dimensoes",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.Tabelas_Dimensao",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "Copy_Oracle_to_ADLS",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:30:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "OracleSource",
									"oracleReaderQuery": {
										"value": "@if(equals(item(), 'OKA_ROTAS_VW'), pipeline().parameters.Query_OKA_ROTAS_VW, concat('SELECT * FROM ', pipeline().parameters.SchemaName, '.', item()))",
										"type": "Expression"
									},
									"partitionOption": "None",
									"queryTimeout": "00:30:00"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_oracle_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"SchemaName": {
											"value": "@pipeline().parameters.SchemaName",
											"type": "Expression"
										},
										"TableName": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"Directory": {
											"value": "@concat(pipeline().parameters.SinkDirectoryRoot, '/', toLower(replace(item(), 'OKJ_', '')))",
											"type": "Expression"
										},
										"FileName": {
											"value": "@concat(toLower(item()), '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"Tabelas_Dimensao": {
				"type": "array",
				"defaultValue": [
					"OKA_ROTAS_VW"
				]
			},
			"SinkDirectoryRoot": {
				"type": "string",
				"defaultValue": "dimensoes"
			},
			"SchemaName": {
				"type": "string",
				"defaultValue": "OKAJIMA"
			},
			"Query_OKA_ROTAS_VW": {
				"type": "string",
				"defaultValue": "SELECT TO_CHAR(CODROTA) AS CODROTA, CAST(ROTA AS VARCHAR2(255 CHAR)) AS ROTA, TO_CHAR(CODROTAPRINC) AS CODROTAPRINC, TO_CHAR(CODUSUR) AS CODUSUR, TO_CHAR(CODCLI) AS CODCLI, TO_CHAR(CODFORNEC) AS CODFORNEC FROM OKAJIMA.OKA_ROTAS_VW"
			}
		},
		"folder": {
			"name": "dimensoes/prod"
		},
		"annotations": [],
		"lastPublishTime": "2026-02-10T16:23:10Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}