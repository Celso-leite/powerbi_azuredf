{
	"name": "pl_dimensoes",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Publication_State",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "SELECT e.entity_name, COALESCE(p.status, 'MISSING') AS status, COALESCE(p.publication_version, 0) AS publication_version, p.run_id, p.target_ref, COALESCE(c.last_consumed_version, 0) AS last_consumed_version, CASE WHEN p.status = 'SUCCESS' AND COALESCE(p.publication_version, 0) > COALESCE(c.last_consumed_version, 0) THEN 1 ELSE 0 END AS should_copy FROM (SELECT 'dimensoes_recorrentes'::text AS entity_name) e LEFT JOIN public.etl_publication_control p ON p.entity_name = e.entity_name LEFT JOIN public.etl_consumer_control c ON c.consumer_name = 'adf_powerbi' AND c.entity_name = e.entity_name;",
							"type": "Expression"
						},
						"queryTimeout": "00:05:00"
					},
					"dataset": {
						"referenceName": "ds_supabase_etl_control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "If_Should_Copy",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Lookup_Publication_State",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(string(activity('Lookup_Publication_State').output.firstRow.should_copy), '1')",
						"type": "Expression"
					},
					"ifFalseActivities": [],
					"ifTrueActivities": [
						{
							"name": "ForEach1",
							"type": "ForEach",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"items": {
									"value": "@pipeline().parameters.Tabelas_Dimensao",
									"type": "Expression"
								},
								"isSequential": false,
								"batchCount": 6,
								"activities": [
									{
										"name": "CopyDimensions",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.01:30:00",
											"retry": 2,
											"retryIntervalInSeconds": 60,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "PostgreSqlV2Source",
												"query": {
													"value": "@if(equals(item(), 'dimcliente_pbi'), 'SET statement_timeout = ''1800000''; SELECT T1.*, COALESCE(T2.base_expo, ''NUMERICA'') as base_expo FROM public.dimcliente_pbi T1 LEFT JOIN public.okj_base_expo T2 ON T1.codigoclienteprincipal = T2.codigoclienteprincipal', concat('SET statement_timeout = ''1800000''; SELECT * FROM public.', item()))",
													"type": "Expression"
												},
												"queryTimeout": "00:30:00"
											},
											"sink": {
												"type": "ParquetSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "ParquetWriteSettings"
												}
											},
											"enableStaging": false,
											"parallelCopies": 4,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "Tabelas_dimensao_supabase",
												"type": "DatasetReference",
												"parameters": {
													"Nome_Tabela_SB": {
														"value": "@item()",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "dw_dimensoes",
												"type": "DatasetReference",
												"parameters": {
													"Nome_Tabela": {
														"value": "@{concat(item(), '.parquet')}",
														"type": "Expression"
													},
													"Nome_Pasta": "dimensoes"
												}
											}
										]
									}
								]
							}
						},
						{
							"name": "Lookup_Update_Consumer_Control",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "ForEach1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 1,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "PostgreSqlV2Source",
									"query": {
										"value": "@concat('SELECT public.sp_atualizar_etl_consumer_control(''adf_powerbi'', ''dimensoes_recorrentes'', ', string(activity('Lookup_Publication_State').output.firstRow.publication_version), ', ''', activity('Lookup_Publication_State').output.firstRow.run_id, ''', ''SUCCESS'') AS last_consumed_version')",
										"type": "Expression"
									},
									"queryTimeout": "00:05:00"
								},
								"dataset": {
									"referenceName": "ds_supabase_etl_consumer_control",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						}
					]
				}
			}
		],
		"parameters": {
			"Tabelas_Dimensao": {
				"type": "array",
				"defaultValue": [
					"dimrca_pbi",
					"dimproduto_pbi",
					"dimcliente_pbi",
					"dimfornecedor_pbi",
					"dimcarregamento_pbi",
					"dimcobranca_pbi",
					"dimemitente_pbi",
					"dimplanopagamento_pbi",
					"dimfilial_pbi",
					"promos_bees_sv_rca",
					"dimmotivodevolucao_pbi"
				]
			}
		},
		"folder": {
			"name": "dimensoes/prod"
		},
		"annotations": [],
		"lastPublishTime": "2026-02-10T13:29:16Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
