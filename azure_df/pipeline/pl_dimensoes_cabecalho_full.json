{
	"name": "pl_dimensoes_cabecalho_full",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Get_All_Anomes",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "@concat('SELECT DISTINCT TO_CHAR(datavenda, ''YYYYMM'') AS anomes FROM ', pipeline().parameters.tableName, ' WHERE datavenda IS NOT NULL ORDER BY 1')",
							"type": "Expression"
						}
					},
					"dataset": {
						"referenceName": "ds_controle_meses_incrementais",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Anomes",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Get_All_Anomes",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_Get_All_Anomes').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 10,
					"activities": [
						{
							"name": "Copy_Historical_Partition",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:30:00",
								"retry": 3,
								"retryIntervalInSeconds": 180,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "PostgreSqlV2Source",
									"query": {
										"value": "@concat('SELECT * FROM ', pipeline().parameters.tableName, ' WHERE TO_CHAR(datavenda, ''YYYYMM'') = ''', item().anomes, '''')",
										"type": "Expression"
									},
									"queryTimeout": "01:00:00"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "Tabelas_dimensao_supabase",
									"type": "DatasetReference",
									"parameters": {
										"Nome_Tabela_SB": {
											"value": "@pipeline().parameters.tableName",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "dw_dimensoes_inc_full",
									"type": "DatasetReference",
									"parameters": {
										"Nome_Tabela": {
											"value": "@{last(split(pipeline().parameters.tableName, '.'))}",
											"type": "Expression"
										},
										"anomes": {
											"value": "@item().anomes",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"tableName": {
				"type": "string",
				"defaultValue": "dimcabecalhopedidovenda_pbi"
			}
		},
		"folder": {
			"name": "dimensoes/prod"
		},
		"annotations": [],
		"lastPublishTime": "2026-02-10T13:28:22Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}