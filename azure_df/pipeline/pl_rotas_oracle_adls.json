{
	"name": "pl_rotas_oracle_adls",
	"properties": {
		"activities": [
			{
				"name": "ForEach_Dimensoes",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.TableConfigurations",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "Copy_Oracle_to_ADLS",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:30:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "OracleSource",
									"oracleReaderQuery": {
										"value": "@if(empty(item().QueryOverride), concat('SELECT * FROM ', pipeline().parameters.SchemaName, '.', item().SourceView), item().QueryOverride)",
										"type": "Expression"
									},
									"partitionOption": "None",
									"queryTimeout": "00:30:00"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_oracle_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"SchemaName": {
											"value": "@pipeline().parameters.SchemaName",
											"type": "Expression"
										},
										"TableName": {
											"value": "@item().SourceView",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"Directory": {
											"value": "@concat(pipeline().parameters.SinkDirectoryRoot, '/', item().SinkFolder)",
											"type": "Expression"
										},
										"FileName": {
											"value": "@item().SinkFileName",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"TableConfigurations": {
				"type": "array",
				"defaultValue": [
					{
						"SourceView": "OKJ_DIMROTA_PBI",
						"SinkFolder": "dimrota_pbi",
						"SinkFileName": "dimrota_pbi.parquet",
						"QueryOverride": ""
					},
					{
						"SourceView": "OKJ_DIMROTACOBERTURA_PBI",
						"SinkFolder": "dimrotacobertura_pbi",
						"SinkFileName": "dimrotacobertura_pbi.parquet",
						"QueryOverride": ""
					},
					{
						"SourceView": "OKJ_DIMTELEVENDAS_PBI",
						"SinkFolder": "dimtelevendas_pbi",
						"SinkFileName": "dimtelevendas_pbi.parquet",
						"QueryOverride": ""
					}
				]
			},
			"SinkDirectoryRoot": {
				"type": "string",
				"defaultValue": "dimensoes"
			},
			"SchemaName": {
				"type": "string",
				"defaultValue": "OKAJIMA"
			}
		},
		"folder": {
			"name": "dimensoes/prod"
		},
		"annotations": [],
		"lastPublishTime": "2026-02-10T16:23:10Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}