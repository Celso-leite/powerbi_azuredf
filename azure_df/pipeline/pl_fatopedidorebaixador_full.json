{
	"name": "pl_fatopedidorebaixador_full",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Anomes_Historico",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "OracleSource",
						"oracleReaderQuery": {
							"value": "@concat('SELECT DISTINCT CAST(ANOMES_ENTRADA_PEDIDO AS VARCHAR2(6)) AS ANOMES_ENTRADA_PEDIDO FROM ', pipeline().parameters.SchemaName, '.OKJ_FATOPEDIDOREBAIXADOR_PBI WHERE ANOMES_ENTRADA_PEDIDO IS NOT NULL ORDER BY 1')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_oracle_query_consulting",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Anomes",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Anomes_Historico",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_Anomes_Historico').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy_Oracle_to_ADLS_Anomes",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:30:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "OracleSource",
									"oracleReaderQuery": {
										"value": "@concat('SELECT * FROM ', pipeline().parameters.SchemaName, '.OKJ_FATOPEDIDOREBAIXADOR_PBI WHERE DATA_ENTRADA_PEDIDO >= TO_DATE(''', item().ANOMES_ENTRADA_PEDIDO, ''', ''YYYYMM'') AND DATA_ENTRADA_PEDIDO < ADD_MONTHS(TO_DATE(''', item().ANOMES_ENTRADA_PEDIDO, ''', ''YYYYMM''), 1)')",
										"type": "Expression"
									},
									"partitionOption": "None",
									"queryTimeout": "00:30:00"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings",
										"compressionCodec": "snappy"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_oracle_query_consulting",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_dynamic_okj",
									"type": "DatasetReference",
									"parameters": {
										"Directory": {
											"value": "@concat(pipeline().parameters.SinkDirectoryRoot, '/', toLower(replace('OKJ_FATOPEDIDOREBAIXADOR_PBI', 'OKJ_', '')))",
											"type": "Expression"
										},
										"FileName": {
											"value": "@concat(toLower('OKJ_FATOPEDIDOREBAIXADOR_PBI'), '_', item().ANOMES_ENTRADA_PEDIDO, '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"SchemaName": {
				"type": "string",
				"defaultValue": "OKAJIMA"
			},
			"SinkDirectoryRoot": {
				"type": "string",
				"defaultValue": "fatos"
			}
		},
		"folder": {
			"name": "fatopedidorebaixador/pl_rebaixador_otimizado"
		},
		"annotations": [],
		"lastPublishTime": "2026-02-03T20:02:31Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}