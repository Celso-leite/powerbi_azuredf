{
	"name": "pl_fato_est",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Publication_State",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "SELECT p.entity_name, p.status, p.publication_version, p.run_id, p.target_ref, COALESCE(c.last_consumed_version, 0) AS last_consumed_version, CASE WHEN p.status = 'SUCCESS' AND p.publication_version > COALESCE(c.last_consumed_version, 0) THEN 1 ELSE 0 END AS should_copy FROM public.etl_publication_control p LEFT JOIN public.etl_consumer_control c ON c.consumer_name = 'adf_powerbi' AND c.entity_name = p.entity_name WHERE p.entity_name = 'fatoestoqueatual_pbi';",
							"type": "Expression"
						},
						"queryTimeout": "00:05:00"
					},
					"dataset": {
						"referenceName": "ds_supabase_etl_control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "If_Should_Copy",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Lookup_Publication_State",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(string(activity('Lookup_Publication_State').output.firstRow.should_copy), '1')",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Copy_Estoque_Atual",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:30:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "PostgreSqlV2Source",
									"query": {
										"value": "SET statement_timeout = '1800000'; SELECT * FROM public.fatoestoqueatual_pbi;",
										"type": "Expression"
									},
									"queryTimeout": "00:30:00"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"parallelCopies": 4,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "Tabelas_dimensao_supabase",
									"type": "DatasetReference",
									"parameters": {
										"Nome_Tabela_SB": {
											"value": "fatoestoqueatual_pbi",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "dw_dimensoes",
									"type": "DatasetReference",
									"parameters": {
										"Nome_Tabela": {
											"value": "fatoestoqueatual_pbi.parquet",
											"type": "Expression"
										},
										"Nome_Pasta": "dimensoes"
									}
								}
							]
						},
						{
							"name": "Lookup_Update_Consumer_Control",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Copy_Estoque_Atual",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 1,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "PostgreSqlV2Source",
									"query": {
										"value": "@concat('SELECT public.sp_atualizar_etl_consumer_control(''adf_powerbi'', ''fatoestoqueatual_pbi'', ', string(activity('Lookup_Publication_State').output.firstRow.publication_version), ', ''', activity('Lookup_Publication_State').output.firstRow.run_id, ''', ''SUCCESS'') AS last_consumed_version')",
										"type": "Expression"
									},
									"queryTimeout": "00:05:00"
								},
								"dataset": {
									"referenceName": "ds_supabase_etl_consumer_control",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						}
					]
				}
			}
		],
		"folder": {
			"name": "fatos"
		},
		"annotations": [],
		"lastPublishTime": "2026-02-10T13:29:16Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}