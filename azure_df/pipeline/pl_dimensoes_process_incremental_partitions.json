{
	"name": "pl_dimensoes_process_incremental_partitions",
	"properties": {
		"activities": [
			{
				"name": "ForEach_Anomes",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.anomesList",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Delete_Incremental_File",
							"type": "Delete",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 1,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "dw_dimensoes_incremental",
									"type": "DatasetReference",
									"parameters": {
										"Nome_Tabela": {
											"value": "@{last(split(pipeline().parameters.tableName, '.'))}",
											"type": "Expression"
										},
										"anomes": {
											"value": "@item().anomes",
											"type": "Expression"
										},
										"FileSystem": {
											"value": "@pipeline().parameters.fileSystem",
											"type": "Expression"
										}
									}
								},
								"enableLogging": false,
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								}
							}
						},
						{
							"name": "Copy_Incremental_Partition",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Delete_Incremental_File",
									"dependencyConditions": [
										"Succeeded",
										"Skipped"
									]
								}
							],
							"policy": {
								"timeout": "0.02:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 180,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "PostgreSqlV2Source",
									"query": {
										"value": "@if(equals(last(split(pipeline().parameters.tableName, '.')), 'dimcabecalhopedidovenda_pbi'), concat('SELECT numeropedido, numeropedidorca, numerocarregamento, numeronotafiscal, numerotransacaovenda, codfilial, TO_CHAR(datavenda, ''YYYY-MM-DD'') AS datavenda, TO_CHAR(dataprevisaofaturamento, ''YYYY-MM-DD'') AS dataprevisaofaturamento, TO_CHAR(datafaturamento, ''YYYY-MM-DD'') AS datafaturamento, TO_CHAR(datacancelamento, ''YYYY-MM-DD'') AS datacancelamento, TO_CHAR(dataentrega, ''YYYY-MM-DD'') AS dataentrega, hora, minuto, situacao, condicaovendadescricao, cancelado, tipopedido, codigotipopedido, condicaovenda, observacaopedido, tipovenda_nf, tipovenda_nf_descricao, especie_nf, serie_nf, origempedido, anomes_venda FROM ', pipeline().parameters.tableName, ' WHERE ', pipeline().parameters.anomesColumn, ' = ''', item().anomes, ''''), concat('SELECT * FROM ', pipeline().parameters.tableName, ' WHERE ', pipeline().parameters.anomesColumn, ' = ''', item().anomes, ''''))",
										"type": "Expression"
									},
									"queryTimeout": "01:00:00"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "Tabelas_dimensao_supabase",
									"type": "DatasetReference",
									"parameters": {
										"Nome_Tabela_SB": {
											"value": "@pipeline().parameters.tableName",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "dw_dimensoes_incremental",
									"type": "DatasetReference",
									"parameters": {
										"Nome_Tabela": {
											"value": "@{last(split(pipeline().parameters.tableName, '.'))}",
											"type": "Expression"
										},
										"anomes": {
											"value": "@item().anomes",
											"type": "Expression"
										},
										"FileSystem": {
											"value": "@pipeline().parameters.fileSystem",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"tableName": {
				"type": "string"
			},
			"anomesColumn": {
				"type": "string"
			},
			"anomesList": {
				"type": "array"
			},
			"fileSystem": {
				"type": "string",
				"defaultValue": "powerbi"
			}
		},
		"folder": {
			"name": "dimensoes/prod"
		},
		"annotations": [],
		"lastPublishTime": "2026-02-10T13:28:23Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
